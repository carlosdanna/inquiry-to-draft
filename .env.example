# Copy to .env.local and fill in. Both keys are read on the server only.
# Never prefix them with NEXT_PUBLIC.

# Bearer token for the Proposales developer interface (https://api.proposales.com/v3)
PROPOSALES_API_KEY=

# Key for the Jev decision model by TypeSafe
JEV_API_KEY=

# Optional. The Proposales company to read content from and create proposals in.
# When empty, the app uses the only company the token can access.
PROPOSALES_COMPANY_ID=
